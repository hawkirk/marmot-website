---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Screenshot from '../components/Screenshot.astro';
import Spotlight from '../components/Spotlight.astro';
import Features from '../components/Features.astro';
import Philosophy from '../components/Philosophy.astro';
import Comparison from '../components/Comparison.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <main id="main">
    <Hero />

    <section class="hero-shot">
      <div class="hero-shot__inner">
        <Screenshot
          src="/screenshots/hero.png"
          aspectRatio="3680/2390"
          alt="Marmot editor showing a manuscript in progress"
        />
      </div>
    </section>

    <Spotlight
      eyebrow="Write"
      title="Write without distraction."
      body="Marmot's editor is built to get out of your way as you write. Inline syntax markers, no toolbars, no chrome — just your prose."
      bullets={[
        'Toggle focus mode to dim everything but the current sentence.',
        'Smart typography handles em-dashes, smart quotes, and ellipses as you type.',
        'Optimized for performance — write in projects with hundreds of thousands of words lag-free.',
      ]}
      src="/screenshots/editor.png"
      alt="Marmot editor in focus mode, with one sentence highlighted and surrounding paragraphs dimmed"
      aspectRatio="2528/2394"
      imageSide="right"
    />

    <Spotlight
      eyebrow="Read"
      title="Read your prose as finished book."
      body="Switch to reader mode any time to see your manuscript typeset like the printed page. Identify pacing problems and dense paragraphs before your editor finds them."
      bullets={[
        'Choose between three custom viewing styles.',
        'Skim whole chapters or zoom in on a single page.',
      ]}
      src="/screenshots/reader.png"
      alt="Marmot in reader mode, showing a typeset chapter on the page"
      aspectRatio="1952/2394"
      imageSide="left"
      background="sunken"
    />

    <Spotlight
      eyebrow="Send"
      title="Submission-ready, instantly."
      body="One-click exports in industry standard manuscript formats, ready to submit to agents and publishers."
      bullets={[
        'Export as PDF or DOCX.',
        'Select and customize three unique export styles.',
        'Export individual chapters or the entire manuscript as one file.',
      ]}
      src="/screenshots/export-manuscript.png"
      alt="A page of a Shunn-formatted manuscript PDF exported from Marmot"
      aspectRatio="1952/2394"
      imageSide="right"
    />

    <Features />

    <section class="detail-shot section--tight">
      <div class="container detail-shot__inner">
        <header class="detail-shot__header">
          <p class="eyebrow">In your workflow</p>
          <h2>Your files. Your tools. Your way.</h2>
          <p class="lede">
            Marmot stores every manuscript as a folder of plain Markdown
            files. That means version control, cloud sync, and backups all
            stay in your hands — using tools you already trust.
          </p>
        </header>
        <div class="detail-shot__viewer">
          <Screenshot
            placeholderLabel="Manuscript on disk"
            placeholderHint="Finder window showing the folder of .md files alongside the Marmot editor"
            aspectRatio="21/9"
            alt="Manuscript folder structure shown next to Marmot"
          />
        </div>
      </div>
    </section>

    <Philosophy />
    <Comparison />
    <FAQ />
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero-shot {
    padding-top: var(--space-4);
    padding-bottom: clamp(var(--space-7), 8vw, var(--space-9));
    position: relative;
  }

  .hero-shot::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--surface-sunken) 40%, transparent)
    );
    pointer-events: none;
    z-index: -1;
  }

  .hero-shot__inner {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  @media (min-width: 48rem) {
    .hero-shot__inner {
      padding-inline: var(--space-6);
    }
  }

  .detail-shot__inner {
    max-width: var(--container-wide);
  }

  .detail-shot__header {
    max-width: 44rem;
    margin-bottom: var(--space-7);
  }

  .detail-shot__header h2 {
    margin-bottom: var(--space-3);
  }
</style>
