---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Screenshot from '../components/Screenshot.astro';
import Spotlight from '../components/Spotlight.astro';
import Features from '../components/Features.astro';
import Comparison from '../components/Comparison.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <main id="main">
    <Hero />

    <section class="hero-shot">
      <div class="hero-shot__inner">
        <Screenshot
          src="/screenshots/hero.png"
          aspectRatio="3680/2390"
          alt="Marmot editor showing a manuscript in progress"
        />
      </div>
    </section>

    <Spotlight
      id="write"
      eyebrow="Write"
      title="Write without distraction."
      body="Marmot's editor is built to get out of your way as you write. Inline syntax markers, no toolbars, no chrome — just your prose."
      bullets={[
        'Toggle focus mode to dim everything but the current sentence.',
        'Typewriter scroll keeps your cursor centered on the page as you write.',
        'Smart typography handles em-dashes, smart quotes, and ellipses as you type.',
        'Optimized for performance — write in projects with hundreds of thousands of words lag-free.',
      ]}
      src="/screenshots/editor.png"
      alt="Marmot editor in focus mode, with one sentence highlighted and surrounding paragraphs dimmed"
      aspectRatio="2528/2394"
      imageSide="right"
    />

    <Spotlight
      id="read"
      eyebrow="Read"
      title="Read your prose like a finished book."
      body="Switch to reader mode any time to see your manuscript typeset like the printed page. Identify pacing problems and dense paragraphs before your editor finds them."
      bullets={[
        'Choose between three custom viewing styles.',
        'Skim whole chapters or zoom in on a single page.',
      ]}
      src="/screenshots/reader.png"
      alt="Marmot in reader mode, showing a typeset chapter on the page"
      aspectRatio="1952/2394"
      imageSide="left"
      background="sunken"
    />

    <Spotlight
      id="export"
      eyebrow="Export"
      title="Submission-ready, instantly."
      body="One-click exports in industry standard manuscript formats, ready to submit to agents and publishers."
      bullets={[
        'Export as PDF or DOCX.',
        'Select and customize three unique export styles.',
        'Export individual chapters or the entire manuscript as one file.',
      ]}
      src="/screenshots/export-manuscript.png"
      alt="A page of an industry-standard manuscript PDF exported from Marmot"
      aspectRatio="1952/2394"
      imageSide="right"
    />

    <section id="goals" class="goals section" aria-labelledby="goals-heading">
      <div class="container goals__inner">
        <div class="goals__image goals__image--left">
          <img
            src="/screenshots/word-count-goals-left.png"
            alt="Marmot's goals popover showing 15,693 of 100,000 manuscript words written and 24 of a 250-word daily target"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="goals__text">
          <p class="eyebrow">Goals</p>
          <h2 id="goals-heading" class="goals__title">Stay on pace.</h2>
          <p class="goals__body">Set a manuscript word count and a daily target to track your progress at a glance.</p>
        </div>
      </div>
    </section>

    <Spotlight
      id="themes"
      eyebrow="Themes"
      title="Make it yours."
      body="Marmot ships with 15 carefully crafted light and dark themes, and has a built-in theme editor for customization."
      src="/screenshots/themes-transparent-background.png"
      alt="Marmot's theme editor showing typography and color customization controls"
      aspectRatio="2880/1800"
      imageSide="left"
    />

    <Features />

    <Comparison />
    <FAQ />
  </main>
  <Footer />
</BaseLayout>

<style>
  .goals {
    background: var(--surface-sunken);
    border-block: 1px solid var(--rule);
    overflow: hidden;
  }

  .goals__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  .goals__image {
    order: 2;
  }

  .goals__text {
    order: 1;
  }

  .goals__text {
    max-width: 32rem;
  }

  .goals__title {
    font-size: var(--step-3);
    margin-bottom: var(--space-4);
  }

  .goals__body {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--muted);
    max-width: var(--measure);
  }

  .goals__image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .goals__image--left img {
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 1.25rem);
    mask-image: linear-gradient(to right, transparent 0, #000 1.25rem);
  }

  @media (min-width: 56rem) {
    .goals__inner {
      grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
      gap: var(--space-6);
    }

    .goals__image {
      order: 0;
    }

    .goals__text {
      order: 0;
    }
  }

  .hero-shot {
    padding-top: var(--space-4);
    padding-bottom: clamp(var(--space-7), 8vw, var(--space-9));
    position: relative;
  }

  .hero-shot::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--surface-sunken) 40%, transparent)
    );
    pointer-events: none;
    z-index: -1;
  }

  .hero-shot__inner {
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  @media (min-width: 48rem) {
    .hero-shot__inner {
      padding-inline: var(--space-6);
    }
  }

</style>
