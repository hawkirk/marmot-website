---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { SITE, SOCIAL } from '../data/site';

const channels = [
  {
    name: 'Email',
    handle: SITE.supportEmail,
    href: `mailto:${SITE.supportEmail}`,
    external: false,
    icon: 'email',
  },
  {
    name: 'X',
    handle: SOCIAL.x.handle,
    href: SOCIAL.x.url,
    external: true,
    icon: 'x',
  },
  {
    name: 'Bluesky',
    handle: SOCIAL.bluesky.handle,
    href: SOCIAL.bluesky.url,
    external: true,
    icon: 'bluesky',
  },
  {
    name: 'Reddit',
    handle: SOCIAL.reddit.handle,
    href: SOCIAL.reddit.url,
    external: true,
    icon: 'reddit',
  },
] as const;
---

<BaseLayout
  title="Help — Marmot"
  description="Get in touch about Marmot."
>
  <main id="main">
    <section class="help">
      <div class="container">
        <h1 class="eyebrow help__heading">Help</h1>

        <div class="help__intro">
          <h2>Need help?</h2>
          <p>
            If you have questions, feature requests, or need to report a bug, please
            don't hesitate to reach out!
          </p>
        </div>

        <ul class="help__list" role="list">
          {channels.map((channel) => (
            <li class="help-channel">
              <a
                class="help-channel__link"
                href={channel.href}
                target={channel.external ? '_blank' : undefined}
                rel={channel.external ? 'noopener noreferrer' : undefined}
              >
                <span class="help-channel__icon" aria-hidden="true">
                  {channel.icon === 'email' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="5" width="18" height="14" rx="2"/>
                      <path d="m3 7 9 6 9-6"/>
                    </svg>
                  )}
                  {channel.icon === 'x' && (
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                  )}
                  {channel.icon === 'bluesky' && (
                    <svg viewBox="0 0 600 530" width="22" height="22" fill="currentColor">
                      <path d="m135.72 44.03c66.5 49.92 138.02 151.14 164.28 205.46 26.26-54.32 97.78-155.54 164.28-205.46 47.97-36.02 125.72-63.88 125.72 24.83 0 17.72-10.16 148.83-16.12 170.13-20.71 74.08-96.34 93.16-163.65 81.71 117.69 20.03 147.61 86.49 83.06 152.96-122.55 126.26-176.16-31.69-189.91-72.18-2.52-7.42-3.7-10.89-3.7-7.96 0-2.92-1.18.54-3.7 7.96-13.76 40.49-67.34 198.43-189.92 72.18-64.56-66.47-34.62-132.93 83.07-152.96-67.32 11.45-142.95-7.63-163.66-81.71-5.96-21.3-16.12-152.41-16.12-170.13 0-88.71 77.75-60.84 125.72-24.83z"/>
                    </svg>
                  )}
                  {channel.icon === 'reddit' && (
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                      <path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
                    </svg>
                  )}
                </span>
                <span class="help-channel__text">
                  <span class="help-channel__name">{channel.name}</span>
                  <span class="help-channel__handle">{channel.handle}</span>
                </span>
                <span class="help-channel__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .help {
    padding-block: clamp(var(--space-7), 8vw, var(--space-9)) var(--space-8);
  }

  .help__heading {
    margin-bottom: var(--space-6);
  }

  .help__intro {
    max-width: 40rem;
    margin-bottom: var(--space-7);
  }

  .help__intro h2 {
    font-size: var(--step-4);
    margin-bottom: var(--space-4);
    max-width: 14ch;
  }

  .help__intro p {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--muted);
    max-width: var(--measure);
  }

  .help__list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 36rem;
    border-top: 1px solid var(--rule);
  }

  .help-channel {
    border-bottom: 1px solid var(--rule);
  }

  .help-channel__link {
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-1);
    text-decoration: none;
    color: var(--ink);
    transition: color var(--duration) var(--ease);
  }

  .help-channel__link:hover {
    color: var(--accent);
  }

  .help-channel__icon {
    display: grid;
    place-items: center;
    color: var(--muted);
    transition: color var(--duration) var(--ease);
  }

  .help-channel__link:hover .help-channel__icon {
    color: var(--accent);
  }

  .help-channel__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .help-channel__name {
    font-weight: 600;
    font-size: var(--step-0);
    letter-spacing: -0.005em;
    line-height: 1.2;
    color: var(--ink);
    transition: color var(--duration) var(--ease);
  }

  .help-channel__link:hover .help-channel__name {
    color: var(--accent);
  }

  .help-channel__handle {
    font-size: var(--step--1);
    color: var(--muted);
    font-family: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
    line-height: 1.3;
  }

  .help-channel__arrow {
    font-size: var(--step-0);
    color: var(--muted);
    font-weight: 500;
    transition: transform var(--duration) var(--ease),
                color var(--duration) var(--ease);
  }

  .help-channel__link:hover .help-channel__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
