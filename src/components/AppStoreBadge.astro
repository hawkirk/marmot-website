---
interface Props {
  href?: string;
  comingSoon?: boolean;
}

const { href = '#', comingSoon = true } = Astro.props;

const label = comingSoon ? 'Coming Soon to the Mac App Store' : 'Download on the Mac App Store';
const isPlaceholder = href === '#' || comingSoon;
---

<a
  class:list={['app-store-badge', { 'app-store-badge--placeholder': isPlaceholder }]}
  href={href}
  aria-label={label}
  aria-disabled={isPlaceholder ? 'true' : undefined}
>
  <svg
    class="app-store-badge__apple"
    viewBox="0 0 16 16"
    width="18"
    height="18"
    aria-hidden="true"
    focusable="false"
  >
    <path
      fill="currentColor"
      d="M12.624 8.46c.01-1.62 1.32-2.4 1.38-2.44-.76-1.1-1.93-1.25-2.34-1.27-1-.1-1.95.59-2.46.59-.52 0-1.3-.58-2.14-.56-1.1.02-2.12.64-2.69 1.62-1.15 1.99-.29 4.94.83 6.55.54.79 1.19 1.68 2.04 1.65.82-.03 1.13-.53 2.13-.53.99 0 1.27.53 2.14.51.88-.02 1.44-.8 1.98-1.6.62-.92.88-1.81.9-1.86-.02-.01-1.72-.66-1.77-2.66ZM10.93 3.79c.45-.55.76-1.32.67-2.08-.65.03-1.43.43-1.9.98-.42.49-.79 1.28-.69 2.02.72.06 1.46-.37 1.92-.92Z"
    ></path>
  </svg>
  <span class="app-store-badge__text">
    <span class="app-store-badge__caption">{comingSoon ? 'Coming Soon to the' : 'Download on the'}</span>
    <span class="app-store-badge__title">Mac App Store</span>
  </span>
</a>

<style>
  .app-store-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1.125rem 0.6875rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 10px;
    text-decoration: none;
    line-height: 1;
    font-weight: 500;
    transition: transform var(--duration) var(--ease),
                background-color var(--duration) var(--ease);
    min-height: 48px;
  }

  .app-store-badge:hover {
    color: var(--paper);
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .app-store-badge:focus-visible {
    outline-offset: 4px;
  }

  .app-store-badge--placeholder {
    cursor: not-allowed;
    opacity: 0.85;
  }

  .app-store-badge--placeholder:hover {
    background: var(--ink);
    transform: none;
  }

  .app-store-badge__apple {
    flex-shrink: 0;
  }

  .app-store-badge__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .app-store-badge__caption {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    opacity: 0.8;
  }

  .app-store-badge__title {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
</style>
