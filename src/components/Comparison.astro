---
type Cell = boolean | string | null;

interface Row {
  feature: string;
  marmot: Cell;
  other_apps: Cell;
}

// Placeholder content — edit these rows freely.
const rows: Row[] = [
  { feature: 'Files stored as plain Markdown',     marmot: true,  other_apps: false  },
  { feature: 'No account or sign-in required',     marmot: true,  other_apps: false  },
  { feature: 'Works fully offline',                marmot: true,  other_apps: true  },
  { feature: 'One-time purchase (no subscription)',marmot: true,  other_apps: false  },
  { feature: 'Shunn manuscript PDF export',        marmot: true,  other_apps: false },
  { feature: 'Built specifically for novels',      marmot: true,  other_apps: false },
  { feature: 'Native macOS app (not Electron)',    marmot: true,  other_apps: true  },
  { feature: 'Zero telemetry',                     marmot: true,  other_apps: false },
];

const apps = [
  { key: 'marmot',    name: 'Marmot',     highlight: true  },
  { key: 'other_apps',   name: 'Other Apps',    highlight: false },
] as const;

function renderCell(value: Cell): { symbol: string; label: string; tone: 'yes' | 'no' | 'neutral' } {
  if (value === true)  return { symbol: '✓', label: 'Yes',         tone: 'yes' };
  if (value === false) return { symbol: '—', label: 'No',          tone: 'no' };
  if (value === null)  return { symbol: '·', label: 'Unspecified', tone: 'neutral' };
  return { symbol: value, label: value, tone: 'neutral' };
}
---

<section class="comparison section" aria-labelledby="comparison-heading">
  <div class="container">
    <header class="comparison__header">
      <p class="eyebrow">Compared</p>
      <h2 id="comparison-heading">A different shape of writing app.</h2>
      <p class="lede">
        Marmot is opinionated. Here is how it lines up against the other Mac
        writing apps you might be considering. Cells you can edit live in
        <code>src/components/Comparison.astro</code>.
      </p>
    </header>

    <div class="comparison__scroll" role="region" tabindex="0" aria-label="Feature comparison table">
      <table class="comparison__table">
        <caption class="sr-only">Marmot compared with Ulysses, Scrivener, and iA Writer</caption>
        <thead>
          <tr>
            <th scope="col" class="comparison__feature-col">Feature</th>
            {apps.map((app) => (
              <th scope="col" class:list={['comparison__app-col', { 'is-highlight': app.highlight }]}>
                {app.name}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th scope="row" class="comparison__feature">{row.feature}</th>
              {apps.map((app) => {
                const cell = renderCell(row[app.key as keyof Row] as Cell);
                return (
                  <td class:list={['comparison__cell', `comparison__cell--${cell.tone}`, { 'is-highlight': app.highlight }]}>
                    <span aria-hidden="true">{cell.symbol}</span>
                    <span class="sr-only">{cell.label}</span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="comparison__footnote">
      Information about other apps reflects their publicly stated features at
      the time of writing. Trademarks and product names belong to their owners.
    </p>
  </div>
</section>

<style>
  .comparison__header {
    margin-bottom: var(--space-7);
    max-width: 44rem;
  }

  .comparison__header h2 {
    margin-bottom: var(--space-3);
  }

  .comparison__header code {
    background: var(--rule-soft);
    color: var(--ink);
    padding: 1px 6px;
    border-radius: var(--radius);
    font-size: 0.85em;
    font-family: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
  }

  .comparison__scroll {
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper);
    scrollbar-width: thin;
  }

  .comparison__scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .comparison__table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: var(--step-0);
  }

  .comparison__table thead {
    background: var(--surface-sunken);
  }

  .comparison__table th,
  .comparison__table td {
    padding: var(--space-4) var(--space-5);
    text-align: left;
    border-bottom: 1px solid var(--rule);
  }

  .comparison__table tbody tr:last-child th,
  .comparison__table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparison__feature-col {
    font-weight: 500;
    color: var(--muted);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    width: 40%;
  }

  .comparison__app-col {
    font-weight: 600;
    color: var(--ink);
    text-align: center;
    font-size: var(--step-0);
    letter-spacing: -0.005em;
  }

  .comparison__app-col.is-highlight {
    color: var(--accent);
  }

  .comparison__feature {
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.005em;
  }

  .comparison__cell {
    text-align: center;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--muted);
  }

  .comparison__cell--yes {
    color: var(--check);
    font-weight: 600;
  }

  .comparison__cell--no {
    color: var(--muted-soft);
  }

  .comparison__cell.is-highlight {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .comparison__cell--yes.is-highlight {
    color: var(--accent);
  }

  .comparison__footnote {
    margin-top: var(--space-5);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: var(--measure);
  }

  @media (max-width: 36rem) {
    .comparison__table th,
    .comparison__table td {
      padding: var(--space-3) var(--space-4);
    }
  }
</style>
