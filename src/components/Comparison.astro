---
interface Row {
  marmot: string;
  otherApps: string;
}

const rows: Row[] = [
  {
    marmot: 'Your novel lives in plain Markdown files — open it in any editor, anywhere.',
    otherApps: 'Your work is locked in a proprietary database or filetype. If the app goes, so does your access.',
  },
  {
    marmot: 'One-time purchase. Buy once, own forever.',
    otherApps: 'Indefinite monthly or annual subscription.',
  },
  {
    marmot: 'Purpose-built for novelists writing long-form fiction without distraction.',
    otherApps: "General-purpose writing apps, or apps with features you don't need to complete your manuscript.",
  },
  {
    marmot: 'No accounts. No telemetry. Your files stay on your Mac.',
    otherApps: 'Many writing tools require a cloud account; some collect usage data.',
  },
];
---

<section id="comparison" class="comparison section" aria-labelledby="comparison-heading">
  <div class="container">
    <header class="comparison__header">
      <p id="comparison-heading" class="eyebrow">Why Marmot</p>
      <p class="lede">
        Most writing apps are expensive and bloated. Here's how Marmot is different.
      </p>
    </header>

    <div class="comparison__wrap">
      <table class="comparison__table" aria-describedby="comparison-footnote">
        <thead>
          <tr>
            <th scope="col" class="comparison__th comparison__th--marmot">Marmot</th>
            <th scope="col" class="comparison__th comparison__th--other">Other apps</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td class="comparison__td comparison__td--marmot">
                <div class="comparison__cell">
                  <svg class="comparison__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 12 5 5 9-11" />
                  </svg>
                  <span>{row.marmot}</span>
                </div>
              </td>
              <td class="comparison__td comparison__td--other">
                <div class="comparison__cell">
                  <svg class="comparison__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14" />
                  </svg>
                  <span>{row.otherApps}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p id="comparison-footnote" class="comparison__footnote">
      "Other apps" is a generalization across the writing tools novelists most
      commonly choose between — any given app may differ on any given row.
      Reflects publicly available information at the time of writing.
    </p>
  </div>
</section>

<style>
  .comparison__header {
    margin-bottom: var(--space-7);
    max-width: 44rem;
  }

  .comparison__wrap {
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--paper);
  }

  .comparison__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }

  .comparison__th,
  .comparison__td {
    width: 50%;
    text-align: left;
    vertical-align: top;
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  .comparison__table tbody tr:last-child .comparison__td {
    border-bottom: none;
  }

  .comparison__th {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-block: var(--space-3);
  }

  .comparison__th--marmot,
  .comparison__td--marmot {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .comparison__th--marmot {
    color: var(--accent);
  }

  .comparison__th--other,
  .comparison__td--other {
    background: var(--surface-sunken);
  }

  .comparison__th--other {
    color: var(--muted);
  }

  .comparison__td--marmot {
    color: var(--ink);
  }

  .comparison__td--other {
    color: var(--muted);
  }

  .comparison__cell {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .comparison__cell span {
    max-width: none;
  }

  .comparison__icon {
    flex-shrink: 0;
    margin-top: 4px;
  }

  .comparison__td--marmot .comparison__icon {
    color: var(--accent);
  }

  .comparison__td--other .comparison__icon {
    color: var(--muted);
  }

  .comparison__footnote {
    margin-top: var(--space-5);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: var(--measure);
  }

  @media (max-width: 36rem) {
    .comparison__th,
    .comparison__td {
      padding: var(--space-3) var(--space-4);
    }

    .comparison__cell {
      font-size: var(--step--1);
      gap: var(--space-2);
    }

    .comparison__icon {
      width: 16px;
      height: 16px;
      margin-top: 3px;
    }
  }
</style>
