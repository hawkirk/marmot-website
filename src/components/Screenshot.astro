---
interface Props {
  /** Path to a screenshot under /public. Leave undefined to render the styled placeholder. */
  src?: string;
  alt?: string;
  caption?: string;
  /** Filename or label shown in the centered title bar of the window chrome. */
  windowTitle?: string;
  /** CSS aspect-ratio value, e.g. "16/10", "4/3", "21/9". */
  aspectRatio?: string;
  /** Label shown inside the placeholder card. Describes what kind of screenshot belongs here. */
  placeholderLabel?: string;
  /** Optional second line in the placeholder card. */
  placeholderHint?: string;
  class?: string;
}

const {
  src,
  alt = 'Marmot screenshot',
  caption,
  windowTitle,
  aspectRatio = '16/10',
  placeholderLabel = 'Screenshot',
  placeholderHint,
  class: className,
} = Astro.props;
---

<figure class:list={['screenshot', className]}>
  <div class="window">
    <div class="window__bar">
      <span class="window__dots" aria-hidden="true">
        <span class="window__dot window__dot--red"></span>
        <span class="window__dot window__dot--yellow"></span>
        <span class="window__dot window__dot--green"></span>
      </span>
      <span class="window__title">{windowTitle}</span>
      <span class="window__bar-end" aria-hidden="true"></span>
    </div>
    <div class="window__content" style={`aspect-ratio: ${aspectRatio}`}>
      {src ? (
        <img src={src} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <div class="window__placeholder" role="img" aria-label={`${placeholderLabel} placeholder`}>
          <div class="window__placeholder-card">
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <circle cx="8.5" cy="10.5" r="1.5"/>
              <path d="m3 17 5-5 4 4 3-3 6 6"/>
            </svg>
            <p class="window__placeholder-label">{placeholderLabel}</p>
            {placeholderHint && <p class="window__placeholder-hint">{placeholderHint}</p>}
          </div>
        </div>
      )}
    </div>
  </div>
  {caption && <figcaption class="screenshot__caption">{caption}</figcaption>}
</figure>

<style>
  .screenshot {
    margin: 0;
  }

  .window {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 2px 4px -2px color-mix(in srgb, var(--ink) 6%, transparent),
      0 24px 56px -24px color-mix(in srgb, var(--ink) 18%, transparent);
  }

  @media (prefers-color-scheme: dark) {
    .window {
      box-shadow:
        0 0 0 1px color-mix(in srgb, var(--ink) 12%, transparent),
        0 30px 70px -24px rgba(0, 0, 0, 0.55);
    }
  }

  .window__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 10px 14px;
    background: var(--surface-sunken);
    border-bottom: 1px solid var(--rule);
    min-height: 36px;
    gap: var(--space-3);
  }

  .window__dots {
    display: flex;
    align-items: center;
    gap: 6px;
    justify-self: start;
  }

  .window__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: block;
  }

  .window__dot--red    { background: #FF5F57; }
  .window__dot--yellow { background: #FEBC2E; }
  .window__dot--green  { background: #28C840; }

  @media (prefers-color-scheme: dark) {
    .window__dot--red    { background: #C9483B; }
    .window__dot--yellow { background: #C99319; }
    .window__dot--green  { background: #289C36; }
  }

  .window__title {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: -0.005em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: none;
    text-align: center;
  }

  .window__bar-end {
    justify-self: end;
  }

  .window__content {
    background: var(--paper);
    position: relative;
    overflow: hidden;
  }

  .window__content img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Placeholder: subtle striped background with a small information card on top. */
  .window__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: var(--space-5);
    background:
      radial-gradient(
        ellipse 60% 80% at 50% 50%,
        color-mix(in srgb, var(--accent) 5%, transparent) 0%,
        transparent 60%
      ),
      repeating-linear-gradient(
        45deg,
        var(--surface-sunken),
        var(--surface-sunken) 10px,
        var(--paper) 10px,
        var(--paper) 20px
      );
  }

  .window__placeholder-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    background: var(--paper);
    border: 1px solid var(--rule);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-lg);
    max-width: 22rem;
    box-shadow: 0 2px 8px -4px color-mix(in srgb, var(--ink) 10%, transparent);
  }

  .window__placeholder-card svg {
    color: var(--muted);
    margin-bottom: var(--space-1);
  }

  .window__placeholder-label {
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.005em;
    max-width: none;
  }

  .window__placeholder-hint {
    font-size: var(--step--1);
    color: var(--muted);
    max-width: none;
  }

  .screenshot__caption {
    margin-top: var(--space-4);
    font-size: var(--step--1);
    color: var(--muted);
    text-align: center;
    max-width: var(--measure);
    margin-inline: auto;
  }
</style>
