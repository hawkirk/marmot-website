---
import AppStoreBadge from './AppStoreBadge.astro';
---

<header class="hero">
  <div class="container hero__inner">
    <h1 class="hero__tagline">Write your novel in pure markdown.</h1>

    <p class="hero__lede">
      <em>Plain Markdown files, a distraction-free editor, and one-click submission-ready
      manuscript exports.</em>
    </p>

    <div class="hero__cta">
      <AppStoreBadge />
    </div>

    <p class="hero__meta">
      <em>Requires macOS 14 or newer.</em>
    </p>
  </div>
</header>

<style>
  .hero {
    padding-top: clamp(var(--space-8), 12vw, var(--space-10));
    padding-bottom: clamp(var(--space-5), 4vw, var(--space-6));
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 40% at 50% 0%,
      color-mix(in srgb, var(--accent) 7%, transparent),
      transparent 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
  }

  .hero__tagline {
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--ink);
    max-width: 22ch;
    margin: 0;
    text-wrap: balance;
  }

  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted);
    max-width: 38ch;
    font-weight: 400;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  .hero__cta {
    margin-top: var(--space-3);
  }

  .hero__meta {
    font-size: var(--step--1);
    color: var(--muted);
    max-width: none;
  }
</style>
